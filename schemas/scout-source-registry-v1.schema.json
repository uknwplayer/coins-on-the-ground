{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coins-on-the-ground.local/schemas/scout-source-registry-v1.schema.json",
  "title": "Coins on the Ground Scout Source Registry V1",
  "type": "object",
  "required": ["format", "sources"],
  "properties": {
    "format": {
      "const": "cog-scout-source-registry-v1"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "display_name", "base_url", "network_surface"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "display_name": {"type": "string", "minLength": 1},
          "base_url": {"type": "string", "minLength": 1},
          "network_surface": {
            "enum": ["clearnet", "onion"]
          },
          "country": {
            "type": ["string", "null"]
          },
          "jurisdiction": {
            "type": ["string", "null"]
          },
          "categories": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1},
            "default": []
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "notes": {
            "type": "string",
            "default": ""
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
