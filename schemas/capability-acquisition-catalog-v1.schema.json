{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coins-on-the-ground.local/schemas/capability-acquisition-catalog-v1.schema.json",
  "title": "Coins on the Ground Capability Acquisition Catalog V1",
  "type": "object",
  "required": ["format", "options"],
  "properties": {
    "format": {
      "const": "cog-capability-acquisition-catalog-v1"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "mode", "provides"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "EXTEND_PROFILE",
              "CONNECT_PROVIDER",
              "BUILD_ADAPTER",
              "ADD_PROFILE",
              "ROUTE_CAPABILITY"
            ]
          },
          "provides": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "browser",
                "http",
                "text_analysis",
                "code",
                "git",
                "file_io",
                "ocr",
                "transcription",
                "email"
              ]
            }
          },
          "target_profile": {
            "type": ["string", "null"]
          },
          "setup_cost_usd": {
            "type": ["string", "null"],
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
          },
          "per_task_cost_usd": {
            "type": ["string", "null"],
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
          },
          "hourly_cost_usd": {
            "type": ["string", "null"],
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
          },
          "setup_minutes_low": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "setup_minutes_high": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "confidence_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "default": 50
          },
          "reusable": {
            "type": "boolean",
            "default": false
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
